---
import clsx from "clsx";
import ExternalLink from "./external-link.astro";

const { pathname } = Astro.props;
---

<footer
  class="
    fixed bottom-0 left-0 right-4 lg:right-4
    flex flex-col lg:flex-row
    items-center lg:items-start
    gap-2 lg:gap-8 py-4 lg:py-6
    px-4 lg:px-8
    bg-zinc-900
    z-20
  "
>
  <!-- 左侧：导航 -->
  <div class="hidden lg:flex items-center gap-8 sm:px-6 md:px-10">
    <div class="flex gap-1 lg:gap-8">
      <ExternalLink href="/" openNewTab={false} pathname={pathname}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="w-6 h-6 text-zinc-500 group-hover:text-zinc-100"
        >
          <title>Home</title>
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M2.335 7.875c-.54 1.127-.35 2.446.03 5.083l.278 1.937c.487 3.388.731 5.081 1.906 6.093S7.447 22 10.894 22h2.212c3.447 0 5.17 0 6.345-1.012s1.419-2.705 1.906-6.093l.279-1.937c.38-2.637.57-3.956.029-5.083s-1.691-1.813-3.992-3.183l-1.385-.825C14.2 2.622 13.154 2 12 2s-2.199.622-4.288 1.867l-1.385.825c-2.3 1.37-3.451 2.056-3.992 3.183M8.25 18a.75.75 0 0 1 .75-.75h6a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75"
            clip-rule="evenodd"
          />
        </svg>
      </ExternalLink>
      <ExternalLink href="/bio" openNewTab={false} pathname={pathname}>
        <span>Bio</span>
      </ExternalLink>
      <ExternalLink href="/research" openNewTab={false} pathname={pathname}>
        <span>Research</span>
      </ExternalLink>
      <ExternalLink href="/publications" openNewTab={false} pathname={pathname}>
        <span>Publications</span>
      </ExternalLink>
      <ExternalLink href="/contact" openNewTab={false} pathname={pathname}>
        <span>Contact</span>
      </ExternalLink>
    </div>
  </div>

  <!-- 移动端：导航 + Copyright -->
  <div class="lg:hidden flex flex-col items-center gap-4 w-full">
    <div class="flex items-center gap-4 mt-1">
      <ExternalLink href="/" openNewTab={false} pathname={pathname}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="w-5 h-5 text-zinc-500 group-hover:text-zinc-100"
        >
          <title>Home</title>
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M2.335 7.875c-.54 1.127-.35 2.446.03 5.083l.278 1.937c.487 3.388.731 5.081 1.906 6.093S7.447 22 10.894 22h2.212c3.447 0 5.17 0 6.345-1.012s1.419-2.705 1.906-6.093l.279-1.937c.38-2.637.57-3.956.029-5.083s-1.691-1.813-3.992-3.183l-1.385-.825C14.2 2.622 13.154 2 12 2s-2.199.622-4.288 1.867l-1.385.825c-2.3 1.37-3.451 2.056-3.992 3.183M8.25 18a.75.75 0 0 1 .75-.75h6a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75"
            clip-rule="evenodd"
          />
        </svg>
      </ExternalLink>
      <ExternalLink href="/bio" openNewTab={false} pathname={pathname}>
        <span>Bio</span>
      </ExternalLink>
      <ExternalLink href="/research" openNewTab={false} pathname={pathname}>
        <span>Research</span>
      </ExternalLink>
      <ExternalLink href="/publications" openNewTab={false} pathname={pathname}>
        <span>Publications</span>
      </ExternalLink>
      <ExternalLink href="/contact" openNewTab={false} pathname={pathname}>
        <span>Contact</span>
      </ExternalLink>
    </div>
    <div class="text-zinc-500 text-center text-base tracking-[0.008em] -mt-1">
      © {new Date().getFullYear()} Yixuan Che. All rights reserved.
    </div>
  </div>

  <!-- 桌面端：右侧 Copyright -->
  <div
  class="
    hidden lg:block text-zinc-500 text-base tracking-[0.008em]
    w-auto 
    text-right
    lg:ml-auto 
  "
  >
    © {new Date().getFullYear()} Yixuan Che. All rights reserved.
  </div>
</footer>
