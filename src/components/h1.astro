---
import clsx from "clsx/lite";

type Props = {
    className?: string;
    size?: "default" | "large";
    fontStyle?: "canela" | "inter";
}

const { size = "default", className, fontStyle = "canela" } = Astro.props;
---

<h1
    class={clsx(
        "text-white text-balance",
        fontStyle === "canela" && "canela-deck-heading",
        fontStyle === "inter" && "font-sans font-bold not-italic",
        size === "default" && "text-6xl md:text-8xl tracking-tight",
        size === "large" && "text-8xl md:text-[120px] lg:text-[160px] tracking-tighter",
        className,
    )}
>
    <slot />
</h1>
