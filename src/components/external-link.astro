---
import clsx from "clsx/lite";

type Props =  {
        href: string
        openNewTab?: boolean
        pathname?: string // 可选，从父组件传递当前路径
}

const { href, openNewTab = true, pathname } = Astro.props;

function normalize(p: string | undefined) {
    if (!p) return "/";
    if (p.length > 1 && p.endsWith("/")) return p.slice(0, -1);
    return p;
}

const isActiveServer = normalize(pathname) === normalize(href);
---

<a href={href} target={openNewTab ? "_blank" : "_self"} data-active-check data-href={href}
        class={clsx(
                "w-fit group flex items-center gap-1 text-base hover:text-zinc-100 cursor-pointer",
                isActiveServer ? "text-zinc-100" : "text-zinc-500"
        )}>
        <slot />
     {openNewTab &&  
                <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <title>Arrow Icon</title>
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h2.5M20 12l-6-6m6 6l-6 6m6-6H9.5"/>
                </svg>
        }
</a>

<!-- 客户端脚本：在 preview/静态环境下运行，确保根据 window.location 高亮当前链接 -->
<script>
    (function(){
        try {
            const norm = (p)=>{ if(!p) return '/'; return p.length>1 && p.endsWith('/') ? p.slice(0,-1) : p };
            const cur = norm(location.pathname || '/');
            document.querySelectorAll('a[data-active-check]').forEach(a=>{
                const h = norm(a.getAttribute('href'));
                if(h === cur) {
                    a.classList.remove('text-zinc-500');
                    a.classList.add('text-zinc-100');
                }
            });
        } catch(e) { /* ignore */ }
    })();
</script>