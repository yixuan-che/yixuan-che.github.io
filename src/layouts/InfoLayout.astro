---
import RootLayout from "./RootLayout.astro";
import Footer from "../components/footer.astro";
import WarpBackground from "../components/warp-background";

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
---

<RootLayout title={title} description={description}>
  <div class="min-h-screen flex flex-col">

    <!-- 主体区域：侧栏 + 内容 -->
    <div class="flex flex-1 relative gap-6 sm:gap-7 w-full">

      <nav class="relative">
        <div class="h-screen w-5 sm:w-10 fixed z-50 overflow-auto left-0 top-0">
          <WarpBackground
            color1="#ffffff" 
            color2="#232326"
            color3="#cba1a1"
            speed={0.4}
            swirl={0.75}
            swirlIterations={10}
            shapeScale={0.25}
            client:load
          />
        </div>
      </nav>

      <main class="relative flex-1">
        <div class="mx-auto w-full max-w-8xl pb-28">
          <slot />
        </div>
      </main>

    </div>

    <!-- footer 永远在底部 -->
    <Footer />

  </div>
</RootLayout>