---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
---

<InfoLayout>
<div class="p-4 sm:pt-8 sm:px-12 pb-8 flex flex-col justify-between">
<div class="space-y-4 sm:space-y-12 pb-30">
     <H1 className="mt-0.5 sm:mt-0"> Bio </H1>
</div>
</div>

<div class="p-4 pt-0 sm:pt-10 sm:px-12 pb-4 flex flex-col">
<div class="text-3xl md:text-4xl text-zinc-100 font-bold pb-4">
     Professional Experience
</div>

<div class="grid grid-cols-1 sm:grid-cols-[4fr_1fr] gap-x-6 pb-2">
     <div class="text-xl md:text-2xl font-semibold text-zinc-100">
     Chair of Theoretical Chemistry, Technische Universität Dresden
     </div>

     <div class="md:text-xl text-zinc-400 md:text-right whitespace-nowrap self-start mt-0.5">
     Aug 2026 – Present
     </div>
     <div class="md:text-xl sm:col-span-2 text-zinc-400">
        <i> Research Associate / Postdoc </i> 
        <br>Advisor: Prof. Thomas Heine
        <br>Humboldt Research Fellowship Programme for Postdocs (Global Minds Initiative Germany, 2026 – 2028)
     </div>
</div>
</div>


<div class="p-4 pt-0 sm:pt-10 sm:px-12 pb-4 flex flex-col">
<div class="text-3xl md:text-4xl text-zinc-100 font-bold pb-4">
     Education
</div>

<div class="grid grid-cols-1 sm:grid-cols-[4fr_1fr] gap-x-6 pb-2">
     <!-- 左侧内容 -->
     <div class="text-xl md:text-2xl font-semibold text-zinc-100">
     Hefei National Research Center for Physical Sciences at the Microscale, University of Science and Technology of China
     </div>

    <!-- 右侧时间 -->
     <div class="md:text-xl text-zinc-400 md:text-right whitespace-nowrap self-start mt-0.5">
      Sept 2022 – Jun 2026
     </div>
     <div class="md:text-xl sm:col-span-2 text-zinc-400">
        <i>Ph.D. in Materials Physics and Chemistry</i> 
        <br> Advisor: Prof. Xiaojun Wu
        <br> Member of National Advanced Talent Cultivation Center for Chemistry (2024 – 2026)
     </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-[4fr_1fr] gap-x-6 pb-2">
     <!-- 左侧内容 -->
     <div class="text-xl md:text-2xl font-semibold text-zinc-100">
     University of Science and Technology of China
     </div>

    <!-- 右侧时间 -->
     <div class="md:text-xl text-zinc-400 md:text-right whitespace-nowrap self-start mt-0.5">
      Sept 2018 – Jul 2022
     </div>
     <div class="md:text-xl text-zinc-400">
        <i>B.Sc. in Materials Chemistry</i>
     </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-[4fr_1fr] gap-x-6 pb-2">
     <!-- 左侧内容 -->
     <div class="text-xl md:text-2xl font-semibold text-zinc-100">
     Liaoning Province Shiyan High School
     </div>

    <!-- 右侧时间 -->
     <div class="md:text-xl text-zinc-400 md:text-right whitespace-nowrap self-start mt-0.5">
      Sept 2015 – Jul 2018
     </div>
     <div class="md:text-xl text-zinc-400">
        <i>High School</i>
     </div>
</div>
</div>

<div class="p-4 pt-0 sm:pt-10 sm:px-12 pb-0 max-[430px]:pb-10 flex flex-col">
<div class="text-3xl md:text-4xl text-zinc-100 font-bold pb-4">
