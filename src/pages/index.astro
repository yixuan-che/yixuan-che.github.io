---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
import WarpBackground from "../components/warp-background";
import AvailableForWork from "../components/available.astro";
---

<RootLayout>
 	<main class="overflow-hidden" style="height: calc(var(--vh, 1vh) * 100);">
 		<div class="group relative w-full flex items-center justify-center" style="height: calc(var(--vh, 1vh) * 100);">
 			<div class="absolute w-full -z-10" style="height: calc(var(--vh, 1vh) * 100);">
				<WarpBackground
					color1="#09090b" 
					color2="#27272a"
					color3="#cba1a1"
					speed={1}
					swirl={0.65}
					swirlIterations={8}
					shapeScale={0.2}
					distortion={0.1}
					client:visible
				/>
			</div>

			<div class="p-5 sm:p-10 absolute w-full flex flex-col justify-between z-10" style="height: calc(var(--vh, 1vh) * 100);">
				<div>
					<H1 size="large" fontStyle="google-sans"> Yixuan <br class="sm:hidden" /> Che </H1>
				</div>

				<div>
					<div class="mb-2 sm:mb-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<span class="text-3xl md:text-4xl text-zinc-100">
							<!-- <span class="md:hidden">Postdoc <br> TU Dresden</span> 
								<span class="hidden md:inline"> </span> -->
								Postdoc · TU Dresden
							</span>
						</div>

						<Navigation client:visible>
							<Link href="/bio" variant="secondary">Bio</Link>
							<Link href="/research" variant="secondary">Research</Link>
							<Link href="/publications" variant="secondary">Publications</Link>
							<Link href="/contact" variant="secondary">Contact</Link>
						</Navigation>
					</div>

					<div class="text-zinc-500 text-base tracking-[0.008em]">
					© {new Date().getFullYear()} Yixuan Che. All rights reserved.
					</div>

				</div>
			</div>
		</div>
	</main>
	<script>
		(() => {
			if (typeof window === 'undefined' || typeof document === 'undefined') return;

			// set --vh for mobile browsers so 100% fills the visible viewport
			const setVh = () => {
				document.documentElement.style.setProperty('--vh', `${window.innerHeight * 0.01}px`);
			};
			setVh();
			window.addEventListener('resize', setVh);
			window.addEventListener('orientationchange', setVh);

			// Disable page scrolling for this page only
			const docEl = document.documentElement;
			const body = document.body;
			const prevDocOverflow = docEl.style.overflow;
			const prevBodyOverflow = body.style.overflow;
			docEl.style.overflow = 'hidden';
			body.style.overflow = 'hidden';
			// restore when navigating away / unload
			window.addEventListener('beforeunload', () => {
				docEl.style.overflow = prevDocOverflow || '';
				body.style.overflow = prevBodyOverflow || '';
			}, { once: true });
		})();
	</script>
</RootLayout>
