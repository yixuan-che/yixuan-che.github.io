---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
import WarpBackground from "../components/warp-background";
import AvailableForWork from "../components/available.astro";
---

<RootLayout>
	<main class="min-h-screen overflow-auto">
		<div class="group relative w-full h-screen flex items-center justify-center">
			<div class="absolute w-full h-screen -z-10">
				<WarpBackground
					color1="#09090b" 
					color2="#27272a"
					color3="#cba1a1"
					speed={1}
					swirl={0.65}
					swirlIterations={8}
					shapeScale={0.2}
					distortion={0.1}
					client:visible
				/>
			</div>

			<div class="p-5 sm:p-10 absolute w-full h-screen flex flex-col justify-between z-10">
				<div>
					<H1 size="large"> Yixuan <br class="sm:hidden" /> Che </H1>
				</div>

				<div>
					<div class="mb-2 sm:mb-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<span class="text-3xl sm:text-4xl text-zinc-100"> Ph.D. Candidate, USTC </span>
						</div>

						<Navigation client:visible>
							<Link href="/bio" variant="secondary">Bio</Link>
							<Link href="/research" variant="secondary">Research</Link>
							<Link href="/publications" variant="secondary">Publications</Link>
							<Link href="/contact" variant="secondary">Contact</Link>
						</Navigation>
					</div>

					<div class="text-zinc-500">
					© {new Date().getFullYear()} Yixuan Che. All rights reserved.
					</div>

				</div>
			</div>
		</div>
	</main>
</RootLayout>

<style>
  /* 禁用页面的垂直滚动条 */
  html, body {
    overflow: hidden;
  }
</style>
