const total = publications.length;
const years = [...new Set(publications.map(p => p.year))].sort((a, b) => b - a);

/* =========================
   Google Scholar静态数据
   请定期手动更新下面的citations和hIndex值
========================= */
const googleScholarData = {
  totalPublications: total, // 自动从publications计算
  totalCitations: 276,      // 请手动更新：你的总引用数
  hIndex: 8,               // 请手动更新：你的H指数
  lastUpdated: "Jul. 22, 2026", // 请更新：最后更新时间
  profileUrl: "https://scholar.google.com/citations?hl=zh-CN&user=P_GoPMoAAAAJ"
};
---

<InfoLayout>
<div class="-mb-10 max-[430px]:mb-9">
  <div class="p-4 sm:pt-8 sm:px-12">
    <H1 className="mt-0.5 sm:mt-0">Publications</H1>
    
    <!-- Google Scholar静态统计卡片 -->
    <div class="mt-15 mb-3 p-6 bg-gradient-to-r from-zinc-600/20 to-zinc-600/20 rounded-[36px] backdrop-blur-sm">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <!-- 中间：统计数据 -->
        <div class="grid grid-cols-3 gap-6 w-full md:w-auto md:flex-1 justify-center md:justify-between">
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold text-zinc-100 bg-gradient-to-r from-red-400 to-orange-400 bg-clip-text text-transparent">
              {googleScholarData.totalPublications}
            </div>
            <div class="text-sm text-zinc-400 mt-2">Publications</div>
          </div>
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold text-zinc-100 bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
              {googleScholarData.totalCitations}
            </div>
            <div class="text-sm text-zinc-400 mt-2">Citations</div>
          </div>
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold text-zinc-100 bg-gradient-to-r from-green-400 to-emerald-400 bg-clip-text text-transparent">
              {googleScholarData.hIndex}
            </div>
            <div class="text-sm text-zinc-400 mt-2">H-index</div>
          </div>
        </div>
        
        <!-- 右侧：更新信息和按钮 -->
        <div class="flex flex-col items-center gap-3 w-full md:w-auto">
          <a 
            href={googleScholarData.profileUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2 bg-gradient-to-r bg-zinc-400/20 hover:bg-zinc-400/60
                   text-zinc-100 rounded-[20px] text-sm font-medium transition-all duration-300 
                    flex items-center gap-2 w-full md:w-auto justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
              <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
            </svg>
            View Full Stats
          </a>
          
          <div class="text-xs text-zinc-500 w-full md:w-auto">
            <div class="flex items-center gap-1 justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              <span>Updated: {googleScholarData.lastUpdated}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="p-4 sm:px-12 mb-4 md:-pb-10">
    <!-- 年份索引 -->
    <div class="mb-1 sticky top-0 bg-zinc-900 backdrop-blur-sm py-4 z-10">
      <div class="flex gap-3 justify-center">
        {years.map(y => (
          <a 
            href={`#${y}`}
            class="w-15 h-8 sm:w-18 sm:h-10 rounded-full bg-zinc-700 hover:bg-red-200/60
                   flex items-center justify-center
                   text-base sm:text-lg text-zinc-100 hover:text-white-100
                   transition-all duration-300"
          >
            {y.toString()}
          </a>
        ))}
      </div>
    </div>

    {years.map(year => {
      const items = publications.filter(p => p.year === year);
      return (
        <div id={String(year)} class="mb-2 pt-18 md:pt-20 -mt-10">
          <h2 class="text-3xl font-bold text-zinc-100 mb-5 border-b border-zinc-100/20 pb-3">
            {year}
          </h2>

          <ul class="space-y-4">
            {items.map(p => {
              const number = total - publications.findIndex(x => x === p);
              return (
                <li class="flex gap-5 items-start">
                  <!-- 圆圈编号/链接 -->
                  <a 
                    href={`https://doi.org/${p.doi}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="View Article"
                    class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-zinc-700 hover:bg-red-200/60
                           flex items-center justify-center
                           text-base sm:text-lg font-semibold text-zinc-100 hover:text-white-100
                           shrink-0 transition-all duration-300 group relative"
                  >
                    <span class="group-hover:opacity-0 transition-opacity duration-300">
                      {number}
                    </span>
                    <svg 
                      xmlns="http://www.w3.org/2000/svg" 
                      class="w-5 h-5 absolute opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                      viewBox="0 0 20 20" 
                      fill="currentColor"
                    >
                      <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                    </svg>
                  </a>

                  <!-- 内容 -->
                  <div class="flex-1">
                    <div class="mt-0.5 sm:mt-1 flex">
                      <p class="text-zinc-100 text-xl sm:text-2xl font-semibold leading-snug" set:html={p.title}></p>
                    </div>
                    <p class="text-base sm:text-lg text-zinc-400 mt-1" set:html={p.authors}></p>
                    <p class="text-base sm:text-lg text-zinc-400 mt-1">
                      <i>{p.journal}</i>&nbsp;<b>{p.year}</b>, {p.volume}, {p.pages}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>
</div>
</InfoLayout>
