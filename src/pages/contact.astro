---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import ExternalLink from "../components/external-link.astro";
---

<InfoLayout>
     <!-- 使用 CSS Grid 自适应高度 -->
     <div class="p-4 sm:pt-8 mt-0.5 sm:px-12 pb-20 grid grid-rows-[auto_1fr_auto] h-screen flex flex-col">
          <!-- 标题行 -->
          <div class="pb-15">
               <H1>Contact</H1>
          </div>
          
          <!-- 主要内容区，不滚动自动适应 -->
          <div class="py-4 flex flex-col justify-between overflow-hidden flex-1">
               <!-- 联系信息在上方 -->
               <div class="flex flex-col justify-start">
                    <p class="text-xl xl:text-2xl text-zinc-400 text-balance">
                         Hefei National Research Center for Physical Sciences at the Microscale, University of Science and Technology of China
                    </p>

                    <div class="mt-6 sm:mt-6 flex flex-col gap-1">
                         <a href="mailto:yxche@mail.ustc.edu.cn" class="w-fit group flex items-center gap-1 text-base lg:text-xl text-zinc-400 hover:text-zinc-50">
                              yxche@mail.ustc.edu.cn
                              <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="24" height="24" viewBox="0 0 24 24">
                                   <title>Arrow Icon</title>
                                   <path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
                                   <path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"/>
                              </svg>
                         </a>

                         <a href="mailto:yxche@outlook.com" class="mb-6 w-fit group flex items-center gap-1 text-base lg:text-xl text-zinc-400 hover:text-zinc-50">
                              yxche@outlook.com
                              <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="24" height="24" viewBox="0 0 24 24">
                                   <title>Arrow Icon</title>
                                   <path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
                                   <path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"/>
                              </svg>
                         </a>

                         <ExternalLink href="https://scholar.google.com/citations?hl=zh-CN&user=P_GoPMoAAAAJ">Google Scholar</ExternalLink>
                         <ExternalLink href="https://www.researchgate.net/profile/Yixuan_Che">ResearchGate</ExternalLink>
                         <ExternalLink href="https://orcid.org/my-orcid?orcid=0000-0002-3990-6868">ORCID</ExternalLink>
                         <ExternalLink href="https://github.com/yixuan-che">GitHub</ExternalLink>
                    </div>
               </div>

               <!-- 地址信息在下方 -->
               <div class="mt-auto">
                    <p class="text-base text-zinc-500">B-1402, Materials Teaching and Research Building</p>
                    <p class="text-base text-zinc-500">96 Jinzhai Rd.</p>
                    <p class="text-base text-zinc-500">Hefei, Anhui 230026</p>
                    <p class="text-base text-zinc-500">P. R. China</p>
               </div>
          </div>
          
          <!-- 底部空间（可选） -->
          <div class="h-0"></div>
     </div>
</InfoLayout>
