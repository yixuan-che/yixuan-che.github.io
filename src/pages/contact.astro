---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import ExternalLink from "../components/external-link.astro";
---

<InfoLayout lockScroll={true}>
     <!-- 使用 CSS Grid 自适应高度（移动端使用 --vh 保证与可视窗口一致） -->
     <div class="p-4 sm:pt-8 sm:px-12 pb-8 flex flex-col grid grid-rows-[auto_1fr_auto]" style="height: calc(var(--vh, 1vh) * 100);">
          <!-- 标题行 -->
          <div class="contact-title pb-4 mt-0.5">
               <H1>Contact</H1>
          </div>
          
          <!-- 主要内容区，允许页面整体滚动 -->
          <div class="contact-info py-4 flex flex-col justify-between flex-1">
               <!-- 联系信息在上方 -->
               <div class="flex flex-col justify-start">
                    <p class="text-xl lg:text-2xl text-zinc-400 text-balance">
                    University of Science and Technology of China
                    </p>

                    <div class="mt-4 sm:mt-6 flex flex-col gap-1">
                         <a href="mailto:yxche@mail.ustc.edu.cn" class="w-fit group flex items-center gap-1 text-base lg:text-xl text-zinc-400 hover:text-zinc-50">
                              yxche@mail.ustc.edu.cn
                              <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="24" height="24" viewBox="0 0 24 24">
                                   <title>Arrow Icon</title>
                                   <path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
                                   <path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"/>
                              </svg>
                         </a>

                         <a href="mailto:yxche@outlook.com" class="mb-4 sm:mb-6 w-fit group flex items-center gap-1 text-base lg:text-xl text-zinc-400 hover:text-zinc-50">
                              yxche@outlook.com
                              <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="24" height="24" viewBox="0 0 24 24">
                                   <title>Arrow Icon</title>
                                   <path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5"/>
                                   <path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"/>
                              </svg>
                         </a>

                         <ExternalLink href="https://scholar.google.com/citations?hl=zh-CN&user=P_GoPMoAAAAJ">Google Scholar</ExternalLink>
                         <ExternalLink href="https://www.researchgate.net/profile/Yixuan_Che">ResearchGate</ExternalLink>
                         <ExternalLink href="https://orcid.org/my-orcid?orcid=0000-0002-3990-6868">ORCID</ExternalLink>
                         <ExternalLink href="https://github.com/yixuan-che">GitHub</ExternalLink>
                    </div>
               </div>

               <!-- 地址信息在下方 -->
               <div class="contact-address mb-6 lg:mb-10">
                    <p class="text-base text-zinc-500">B-1402, Materials Teaching and Research Building</p>
                    <p class="text-base text-zinc-500">96 Jinzhai Rd.</p>
                    <p class="text-base text-zinc-500">Hefei, Anhui 230026</p>
                    <p class="text-base text-zinc-500">P. R. China</p>
               </div>
          </div>
     </div>
</InfoLayout>

<script>
     (() => {
          if (typeof window === 'undefined' || typeof document === 'undefined') return;

          // set --vh for mobile browsers so 100% fills the visible viewport
          const setVh = () => {
               document.documentElement.style.setProperty('--vh', `${window.innerHeight * 0.01}px`);
          };
          setVh();
          window.addEventListener('resize', setVh);
          window.addEventListener('orientationchange', setVh);

          // lock scrolling for this page only
          const docEl = document.documentElement;
          const body = document.body;
          const prevDocOverflow = docEl.style.overflow;
          const prevBodyOverflow = body.style.overflow;
          docEl.style.overflow = 'hidden';
          body.style.overflow = 'hidden';

          // restore on unload/navigation away
          window.addEventListener('beforeunload', () => {
               docEl.style.overflow = prevDocOverflow || '';
               body.style.overflow = prevBodyOverflow || '';
          }, { once: true });
     })();
</script>
