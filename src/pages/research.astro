     The Shanghai Jiao Tong University Forum for High-Level Doctoral Research
     </div>
    <!-- 右侧时间 -->
     <div class="md:text-xl text-zinc-400 md:text-right whitespace-nowrap self-start">
      Nov 15 – 17, 2025
     </div>
     <div class="md:text-lg sm:col-span-2 text-zinc-400">
        <i>Oral Presentation, Shanghai, China</i> 
     </div>
</div>


<div class="grid grid-cols-1 sm:grid-cols-[4fr_1fr] gap-x-6 pb-2">
